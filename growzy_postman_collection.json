                "url": "localhost/GROWZY/routes/api.php/forgot-password",
                "description": "<h2>Forgot Password</h2><p>Generates a password reset JWT token and stores it in the database.</p><h3>Request Body</h3><table><thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead><tbody><tr><td><code>email</code></td><td>string</td><td>Yes</td><td>The email address associated with the user account.</td></tr></tbody></table><h3>Responses</h3><table><thead><tr><th>Status</th><th>Description</th><th>Body</th></tr></thead><tbody><tr><td><code>200 OK</code></td><td>Reset token generated successfully.</td><td><code>{\"message\": \"Reset token generated\", \"data\": {\"token\": \"RESET_JWT_TOKEN\"}}</code></td></tr><tr><td><code>404 Not Found</code></td><td>No account found with the provided email address.</td><td><code>{\"message\": \"User not found\"}</code></td></tr><tr><td><code>500 Internal Server Error</code></td><td>Failed to save the reset token to the database.</td><td><code>{\"message\": \"Failed to save reset token\"}</code></td></tr></tbody></table>",
                "urlObject": {
