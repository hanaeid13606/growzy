            },
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\r\n  \"email\": \"medhat@gmail.com\",\r\n  \"password\": \"password123\"\r\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "localhost/GROWZY/routes/api.php/login",
                "description": "<h2>Login</h2><p>Authenticates a user and returns a JWT access token upon successful login.</p><h3>Request Body</h3><table><thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead><tbody><tr><td><code>email</code></td><td>string</td><td>Yes</td><td>The registered email address.</td></tr><tr><td><code>password</code></td><td>string</td><td>Yes</td><td>The account password.</td></tr></tbody></table><h3>Responses</h3><table><thead><tr><th>Status</th><th>Description</th><th>Body</th></tr></thead><tbody><tr><td><code>200 OK</code></td><td>Login successful. Returns a JWT token.</td><td><code>{\"message\": \"Logged in successfully\", \"token\": \"JWT_TOKEN\"}</code></td></tr><tr><td><code>400 Bad Request</code></td><td>Invalid email format.</td><td><code>{\"message\": \"Invalid email format\"}</code></td></tr><tr><td><code>404 Not Found</code></td><td>User with the provided email address not found.</td><td><code>{\"message\": \"User not found\"}</code></td></tr><tr><td><code>401 Unauthorized</code></td><td>Incorrect password.</td><td><code>{\"message\": \"Invalid credentials\"}</code></td></tr></tbody></table>",
                "urlObject": {
                    "path": [
                        "GROWZY",
                        "routes",
                        "api.php",
                        "login"
                    ],
                    "host": [
                        "localhost"
                    ],
                    "query": [],
                    "variable": []
                }
            },
            "response": [],
