        {
            "name": "post register",
            "id": "93b74cee-3c14-4ade-b44e-d36b69a4dad0",
            "protocolProfileBehavior": {
                "disableBodyPruning": true
            },
            "request": {
                "method": "POST",
                "header": [],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"medhat\",\n  \"email\": \"medhat@gmail.com\",\n  \"password\": \"password123\",\n  \"role\": \"investor\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": "localhost/GROWZY/routes/api.php/register",
                "description": "<h2>Register</h2><p>Creates a new user account in the system.</p><h3>Request Body</h3><table><thead><tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr></thead><tbody><tr><td><code>name</code></td><td>string</td><td>Yes</td><td>The full name of the user.</td></tr><tr><td><code>email</code></td><td>string</td><td>Yes</td><td>A unique, valid email address.</td></tr><tr><td><code>password</code></td><td>string</td><td>Yes</td><td>The desired account password.</td></tr><tr><td><code>role</code></td><td>string</td><td>No (default: user)</td><td>The role assigned to the user (e.g. <code>investor</code>, <code>admin</code>).</td></tr><tr><td><code>secret_key</code></td><td>string</td><td>Only for admin</td><td>The secret key to register an admin user. Must match <code>YOUR_SECRET_KEY</code>.</td></tr></tbody></table><h3>Responses</h3><table><thead><tr><th>Status</th><th>Description</th><th>Body</th></tr></thead><tbody><tr><td><code>201 Created</code></td><td>Account created successfully.</td><td><code>{\"message\": \"User registered successfully\"}</code></td></tr><tr><td><code>403 Forbidden</code></td><td>Invalid secret key provided for admin registration.</td><td><code>{\"message\": \"Invalid admin key\"}</code></td></tr><tr><td><code>500 Internal Server Error</code></td><td>Registration failed (e.g., duplicate email address).</td><td><code>{\"message\": \"Registration failed\"}</code></td></tr></tbody></table>",
                "urlObject": {
                    "path": [
                        "GROWZY",
                        "routes",
                        "api.php",
                        "register"
                    ],
                    "host": [
                        "localhost"
                    ],
                    "query": [],
                    "variable": []
                }
            },
